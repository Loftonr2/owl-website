# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/dist

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (do not commit)
.env*.local
.env
.env.production
.env.development

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# editor
.idea
.vscode/*
!.vscode/extensions.json

# OS
Thumbs.db

# Reference-only assets — kept on disk for dev convenience, never shipped.
# Wireframes live here so devs can compare a page they're building against
# the canonical wireframe without leaving the repo.
/public/images/wireframes-reference/

# Dev-only smoke fixtures for <HeroFrameSequence>.
# Generated by `npm run generate:hero-frame-smoke`. Never commit.
/public/images/hero-frames/_dev-smoke/

# YouTube RSS scrape output. Generated by `npm run fetch:youtube`.
# Used as a reference while editing videos.ts. Never commit.
/scripts/.youtube-channel-videos.json

# Original / source hero videos — very large; optimised versions live in public/videos/.
# Store masters in a cloud drive, not in the repository.
/public/videos/originals/

# Backup files created by editors and scripts.
*.bak

# Hero poster JPEGs — production uses .webp versions in this same folder.
/public/images/heroes/*-poster.jpg
